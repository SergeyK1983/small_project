SMPR_POSTGRES_PORT=5432
SMPR_ECHO=True

# auth
SMPR_PASSWORD_FILE=path_to_file
SMPR_PRIVATE_KEY=path_to_file
SMPR_PUBLIC_KEY=path_to_file
SMPR_ALGORITHM=EdDSA
SMPR_ACCESS_TOKEN_EXPIRE_MINUTES=30