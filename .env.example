SMPR_APPLICATION="project"
SMPR_ALLOWED_HOST=["localhost"]
SMPR_SECRETS_DIR=
SMPR_ALLOW_ORIGINS=["*"]
SMPR_ALLOW_HEADERS=["*"]
SMPR_ALLOW_METHODS=["GET","POST","PUT","PATCH","DELETE"]
SMPR_PAYMENT_PSW_FILE=path_to_file

# Настройки PostgreSQL
SMPR_POSTGRES_NAME=postgres
